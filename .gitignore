# Secrets / env
.env
.env.local
.env.*.local

# Archon runtime artifacts — NEVER commit
.archon/mcp/
.archon/state/
.archon/.env
.archon/.env.*
.archon/.run-logs/

# Iteration backups — useful locally during tuning, never commit
**/*.bak
**/*.bak-*
**/.bak-*

# Local Claude Code state (keep project skills, ignore per-user settings)
.claude/settings.local.json
.claude/settings.local.md
.claude/scheduled_tasks.lock

# Dependencies
node_modules/
.pnpm-store/

# Build / output
dist/
build/
out/
*.log

# Python bytecode
__pycache__/
*.pyc

# HyperFrames render artefacts and caches
**/.waveform-cache/
**/out/
**/renders/
videos/**

# TTS chunk intermediates — large + regenerable from narration.txt + edge-tts
videos/*/audio/narration-chunks/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
.gitignore
